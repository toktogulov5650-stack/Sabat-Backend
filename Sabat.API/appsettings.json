{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=sabat;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrations": false,
    "SeedInitialContent": false
  },
  "Admin": {
